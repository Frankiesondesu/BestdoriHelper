<Slide style={{ width: 1280, height: 720, padding: 0, position: 'relative', overflow: 'hidden', background: '#1F2430' }}>

    {/* ===== 背景 ===== */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 720 }}>
        <svg width={1280} height={720} viewBox='0 0 1280 720'>
            <defs>
                <linearGradient id='s1bg' x1='0' y1='0' x2='1' y2='1'>
                    <stop offset='0%' stopColor='#1B1F2A' />
                    <stop offset='100%' stopColor='#2A3242' />
                </linearGradient>
                <radialGradient id='s1glow' cx='0.22' cy='0.72' r='0.66'>
                    <stop offset='0%' stopColor='#E8478B' stopOpacity='0.30' />
                    <stop offset='100%' stopColor='#E8478B' stopOpacity='0' />
                </radialGradient>
            </defs>
            <rect x='0' y='0' width='1280' height='720' fill='url(#s1bg)' />
            <rect x='0' y='0' width='1280' height='720' fill='url(#s1glow)' />

            {/* 右侧细密网格：呼应"一格一格切出来" */}
            <g stroke='#FFFFFF' strokeOpacity='0.045' strokeWidth='1'>
                <line x1='900' y1='0' x2='900' y2='720' />
                <line x1='996' y1='0' x2='996' y2='720' />
                <line x1='1092' y1='0' x2='1092' y2='720' />
                <line x1='1188' y1='0' x2='1188' y2='720' />
                <line x1='900' y1='144' x2='1280' y2='144' />
                <line x1='900' y1='288' x2='1280' y2='288' />
                <line x1='900' y1='432' x2='1280' y2='432' />
                <line x1='900' y1='576' x2='1280' y2='576' />
            </g>
            <rect x='900' y='144' width='96' height='144' fill='#E8478B' fillOpacity='0.20' />
            <rect x='1092' y='432' width='96' height='144' fill='#E8478B' fillOpacity='0.12' />
        </svg>
    </Box>

    {/* ===== 内容 ===== */}
    <Box style={{
        position: 'relative',
        zIndex: 1,
        height: '100%',
        flexDirection: 'column',
        justifyContent: 'center',
        paddingLeft: 96,
        paddingRight: 96,
        gap: 20,
    }}>
        {/* 章节编号：视觉锚点 */}
        <Text style={{ fontSize: 150, fontWeight: 'bold', color: '#E8478B', lineHeight: 1.0, letterSpacing: 2 }}>
            01
        </Text>

        <Text style={{ fontSize: 64, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.15 }}>
            开始使用
        </Text>

        <Box style={{ width: 68, height: 4, background: '#E8478B', borderRadius: 2, marginTop: 6 }} />

        <Text style={{ fontSize: 22, color: '#8A93A6', marginTop: 6 }}>
            从选版本到导出清单，四步走完
        </Text>
    </Box>

</Slide>
