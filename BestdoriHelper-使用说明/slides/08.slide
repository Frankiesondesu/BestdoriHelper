<Slide style={{ width: 1280, height: 720, padding: '20px 72px', background: '#F7F8FA', flexDirection: 'column' }}>

    {/* ===== A · 标题块 ===== */}
    <Box style={{ height: 100, flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 6, height: 38, background: '#E8478B', borderRadius: 3 }} />
        <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1F2430' }}>
            第三步 · 卡面清单
        </Text>
    </Box>

    {/* ===== B · 内容区（左标题栏 32% + 右内容）===== */}
    <Box style={{ flex: 1, flexDirection: 'row' }}>

        {/* 左：深色标题栏 */}
        <Box style={{
            width: 360, background: 'linear-gradient(135deg, #1F2430 0%, #2C3444 100%)',
            borderRadius: '12px 0 0 12px', padding: '36px 32px',
            flexDirection: 'column', justifyContent: 'space-between',
        }}>
            <Box style={{ flexDirection: 'column', gap: 14 }}>
                <Text style={{ fontSize: 72, fontWeight: 'bold', color: '#E8478B', lineHeight: 1.0 }}>3</Text>
                <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.25 }}>
                    清单就是
                    <br />
                    你的卡册
                </Text>
                <Box style={{ width: 44, height: 4, background: '#E8478B', borderRadius: 2 }} />
                <Text style={{ fontSize: 18, color: '#8A93A6', lineHeight: 1.6 }}>
                    确认过的卡会自动汇总，
                    <br />
                    下一步就能导出或同步
                </Text>
            </Box>
            <Text style={{ fontSize: 15, color: '#5A6376' }}>网页版 / 手机 / 桌面 都有</Text>
        </Box>

        {/* 右：截图 + 要点 */}
        <Box style={{
            flex: 1, background: '#FFFFFF', borderRadius: '0 12px 12px 0',
            padding: '26px 30px', flexDirection: 'column', gap: 18,
            boxShadow: '0 2px 12px rgba(31,36,48,0.06)',
        }}>

            <Box style={{
                width: 740, height: 149, marginTop: -8,
                borderRadius: 10, overflow: 'hidden',
                background: '#1F2430', border: '1px solid #2E3442',
            }}>
                <Image src="assets/step3_inventory.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
            </Box>

            <Box style={{ flex: 1, flexDirection: 'column', gap: 11 }}>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <Text style={{ fontSize: 17, color: '#E8478B', fontWeight: 'bold', width: 20 }}>·</Text>
                    <Text style={{ fontSize: 18, color: '#5A6376', lineHeight: 1.5 }}>
                        顶部自动统计：总数、特训后、4★5★、待确认
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <Text style={{ fontSize: 17, color: '#E8478B', fontWeight: 'bold', width: 20 }}>·</Text>
                    <Text style={{ fontSize: 18, color: '#5A6376', lineHeight: 1.5 }}>
                        按卡名 / 角色搜索，也能一键筛出「待确认」
                    </Text>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                    <Text style={{ fontSize: 17, color: '#E8478B', fontWeight: 'bold', width: 20 }}>·</Text>
                    <Text style={{ fontSize: 18, color: '#5A6376', lineHeight: 1.5 }}>
                        <span style={{ color: '#1F2430', fontWeight: 'bold' }}>拿不准的会被标成「待确认」</span>
                        —— 重点检查这些就行
                    </Text>
                </Box>
            </Box>

        </Box>
    </Box>

    {/* ===== C · 页脚条 ===== */}
    <Box style={{ height: 60, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 15, color: '#8A93A6' }}>BestdoriHelper 使用说明</Text>
        <Text style={{ fontSize: 15, color: '#8A93A6' }}>08 / 14</Text>
    </Box>

</Slide>
