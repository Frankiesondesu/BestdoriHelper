            这份说明讲什么
        </Text>
    </Box>

    {/* ===== B · 内容区（左标题栏 32% + 右内容 68%）===== */}
    <Box style={{ flex: 1, flexDirection: 'row' }}>

        {/* 左：深色标题栏 */}
        <Box style={{
            width: 366,
            background: 'linear-gradient(135deg, #1F2430 0%, #2C3444 100%)',
            borderRadius: '12px 0 0 12px',
            padding: '40px 34px',
            flexDirection: 'column',
            justifyContent: 'space-between',
        }}>
            <Box style={{ flexDirection: 'column', gap: 16 }}>
                <Box style={{ width: 44, height: 4, background: '#E8478B', borderRadius: 2 }} />
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.25 }}>
